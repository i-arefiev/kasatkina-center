					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Крупный",
					"size": "1.25rem"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"link": {
				"typography": {
					"textDecoration": "none"
				},
				"color": {
					"text": "inherit"
				}
			}
		}
